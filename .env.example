# Supabase (live mode) — leave unset to run on seeded demo data
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Force the mock/demo data even when Supabase is configured above
# (VITE_USE_MOCK=true = seeded records + demo accounts + local auth)
VITE_USE_MOCK=false
